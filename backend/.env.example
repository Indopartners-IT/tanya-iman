# Copy to .env and fill in. Never commit .env.
# Variable reference: docs/tdd.md section 5.3

# --- Environment -------------------------------------------------------------
ENV=development
GCLOUD_PROJECT=tanya-iman-local

# Development only. MUST be absent (not empty) on Cloud Run — an empty value
# makes the Firestore SDK dial an empty gRPC URI and crash at startup.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# In-memory storage keeps the test suite and first-run development free of any
# emulator dependency. Set to "firestore" once the emulator is running.
STORAGE_BACKEND=memory

# --- Answer engine -----------------------------------------------------------
# "stub" until Phase 5 lands the real pipeline (PIP Task 2.4 / 5.6).
ANSWER_ENGINE=stub
PROMPT_VERSION=0.1.0-stub

LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-latest
LLM_FALLBACK_PROVIDER=fake
LLM_FALLBACK_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-multilingual-embedding-002

# --- Identity ----------------------------------------------------------------
OTP_PROVIDER=fake
OTP_API_KEY=
OTP_SERVICE_SID=
FIREBASE_SERVICE_ACCOUNT=

# Development only: skips Firebase ID token verification and trusts the
# Authorization header as a raw uid. Ignored outside ENV=development.
AUTH_ALLOW_INSECURE_DEV_TOKENS=true

# --- Secrets -----------------------------------------------------------------
ADMIN_JWT_SECRET=change-me-in-every-environment
# Rotating this invalidates every stored phone number. It is a migration,
# not a redeploy. 32 bytes, base64.
PHONE_ENCRYPTION_KEY=

# --- Limits ------------------------------------------------------------------
# Defaults mirror the seeded `system_config` documents (TDD section 3.9). Set
# them here only to override for local testing.
RATE_LIMIT_PER_HOUR=30
OTP_REQUESTS_PER_HOUR=5
MAX_QUESTION_CHARS=1000
SESSION_TTL_HOURS=24
# Prior turns handed to the engine as context (F-6). Bounded on purpose: an
# unbounded history is a cost problem and a growing prompt-injection surface.
CONTEXT_TURNS=3

# --- Web ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRAME_ANCESTORS=https://isadanislam.org,https://isadanalquran.com,https://isadanalfatihah.com,https://isaislamdankaumwanita.com,https://takutneraka.com
