rules_version = '2';

// Clients never touch Firestore directly. Every read and write goes through the
// backend API, which uses the Admin SDK and bypasses these rules. Keeping access
// control in exactly one tested place is deliberate — see TDD section 6.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
